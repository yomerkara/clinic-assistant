# Figma push (code.to.design API) — leave blank to stay in HTML-only mode
CODE_TO_DESIGN_API_KEY=

# Jira — only needed if setup.sh registered a Jira MCP connection.
# Official remote MCP (atlassian/atlassian-mcp-server): uses browser OAuth, no keys needed here.
# Self-hosted MCP (sooperset/mcp-atlassian): fill these in.
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
# Data Center/Server instead of Cloud: use a personal access token and leave USERNAME/API_TOKEN blank.
JIRA_PERSONAL_TOKEN=

# Stitch (Google's Gemini-powered text-to-UI generator) — only needed if you set
# renderer:"stitch" in design-agent.config.json. Get a key from labs.google/stitch ->
# Settings -> API Keys. Called directly via the official @google/stitch-sdk
# (scripts/stitch/generate.mjs), not via MCP — leave blank to stay on the handwritten path.
STITCH_API_KEY=
