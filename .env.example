# Generate each DB password independently: openssl rand -hex 32
# For an existing pgdata volume POSTGRES_ADMIN_PASSWORD must match its current password.
POSTGRES_ADMIN_PASSWORD=""
APP_DATABASE_PASSWORD=""
MIGRATION_DATABASE_PASSWORD=""
# Local TLS: sh scripts/db/tls/generate-local.sh
DB_TLS_DIR="./.local/db-tls"
# Local commands: replace the password placeholders; Compose assembles its own URLs.
DATABASE_URL="postgresql://santa_app:REPLACE_WITH_APP_DATABASE_PASSWORD@localhost:55432/santa?sslmode=require&sslaccept=strict&sslcert=../.local/db-tls/ca.crt"
MIGRATION_DATABASE_URL="postgresql://santa_migrate:REPLACE_WITH_MIGRATION_DATABASE_PASSWORD@localhost:55432/santa?sslmode=require&sslaccept=strict&sslcert=../.local/db-tls/ca.crt"
# Generate independently with: openssl rand -hex 32
SESSION_SECRET=""
APP_URL="https://localhost"
APP_TIMEZONE="Europe/Istanbul"

# Asistan test ortamı — yanıt her zaman gerçek modelden gelir.
OPENAI_API_KEY=""
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_INPUT_USD_PER_MILLION="0"
LLM_OUTPUT_USD_PER_MILLION="0"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_BASE=""
# CLINIC_EMERGENCY_TEXT=""
# Optional only when Google already has the old local callback registered.
GOOGLE_LOCAL_OAUTH_ORIGIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Generate a different value with: openssl rand -hex 32
REMINDER_JOB_SECRET=""
REMINDER_INTERVAL_MS="900000"

# Account security: generate a separate 32-byte hex key; never commit the real key.
DATA_ENCRYPTION_KEY=""
PASSWORD_ROTATION_MONTHS="6"
# Resend: domain-free tests use Santa <onboarding@resend.dev> and can only
# deliver to the email registered on your Resend account. For other recipients,
# use a sender on your verified domain. Never commit a real API key.
RESEND_API_KEY=""
AUTH_MAIL_FROM=""

# Only product tier labels are displayed to clinic users. Prices are USD / 1M tokens.
AI_TIER="BALANCED"
AI_BALANCED_MODEL=""
AI_BALANCED_TARIFF_VERSION=""
AI_BALANCED_PROVIDER_INPUT_USD=""
AI_BALANCED_PROVIDER_OUTPUT_USD=""
AI_BALANCED_CUSTOMER_INPUT_USD=""
AI_BALANCED_CUSTOMER_OUTPUT_USD=""
AI_ECONOMY_MODEL=""
AI_ECONOMY_TARIFF_VERSION=""
AI_ECONOMY_PROVIDER_INPUT_USD=""
AI_ECONOMY_PROVIDER_OUTPUT_USD=""
AI_ECONOMY_CUSTOMER_INPUT_USD=""
AI_ECONOMY_CUSTOMER_OUTPUT_USD=""
AI_ADVANCED_MODEL=""
AI_ADVANCED_TARIFF_VERSION=""
AI_ADVANCED_PROVIDER_INPUT_USD=""
AI_ADVANCED_PROVIDER_OUTPUT_USD=""
AI_ADVANCED_CUSTOMER_INPUT_USD=""
AI_ADVANCED_CUSTOMER_OUTPUT_USD=""

# Yalnızca localhost önizlemede geçici kurulum atlama; canlı ortamda kapalı tutun.
ALLOW_LOCAL_SETUP_SKIP=false


# Reversible conversation engine: legacy | simple. Restart app after changing.
CONVERSATION_FLOW=legacy
# Demo-only observation. Does not alter replies/actions; one call, 8s timeout.
CONTEXT_REVIEW=off
CONTEXT_REVIEW_EXAMPLES=on
# Reversible gateway and task routing. Empty task model uses the UI-selected model.
AI_GATEWAY=direct
AI_GATEWAY_URL=http://127.0.0.1:4001/v1
AI_GATEWAY_KEY=
AI_UNDERSTAND_MODE=off
AI_UNDERSTAND_MODEL=claude-sonnet-4-5
AI_ANSWER_MODEL=qwen-3.6-35b-sovereign
AI_REVIEW_MODEL=qwen-3.6-35b-sovereign
